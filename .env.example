# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
# APP_NAME: Nombre de tu aplicación (se usa para correos, título de la web, etc.)
# APP_ENV: Entorno de ejecución (local, production, testing). Define el comportamiento general de errores y cachés.
# APP_KEY: Clave de cifrado de la app. ¡VITAL! Se autogenera ejecutando el comando: "php artisan key:generate" en tu terminal.
# APP_DEBUG: En "true" muestra pantallas de error detalladas con código. En producción (production) DEBE ser "false" por seguridad.
# APP_URL: La URL pública de tu web. Se usa para construir enlaces e imágenes. Configúralo con el dominio de tu servidor en producción.
# APP_LOCALE, APP_FALLBACK_LOCALE, APP_FAKER_LOCALE: Idiomas por defecto de la aplicación y de los datos falsos.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Variables para el modo de mantenimiento ("php artisan down")
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ==============================================================================
# CONFIGURACIÓN DE LOGS (REGISTRO DE ERRORES)
# ==============================================================================
# LOG_CHANNEL: Dónde se guardan los logs (stack, daily, syslog, errorlog). "stack" suele mandarlo a /storage/logs/laravel.log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==============================================================================
# DB_CONNECTION: Gestor de BBDD a usar (mysql, postgres, sqlite, sqlsrv).
# Los demás datos (Host, BDD, Usuario, Clave) los proporciona tu servicio de base de datos (XAMPP local, Docker, RDS, PlanetScale, etc.)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ==============================================================================
# CONFIGURACIÓN DE SESIONES Y CACHÉ
# ==============================================================================
# SESSION_DRIVER: Dónde se guardan las sesiones de los usuarios (file, cookie, database, redis, memcached).
# CACHE_STORE: Dónde se guardan los datos en caché para mejorar rendimiento.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# FILESYSTEM_DISK: Sistema de archivos (local, public, s3). Define dónde se suben tus imágenes/archivos.
FILESYSTEM_DISK=local
# QUEUE_CONNECTION: Gestor de colas de trabajos en segundo plano (sync, database, redis). "sync" ejecuta todo de inmediato.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Rutas/Hosts si decides usar sistemas en memoria avanzados como Memcached o Redis
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS
# ==============================================================================
# MAIL_MAILER: Sistema de envío (smtp, resend, sendgrid, mailgun). 
# Host, Puerto, Usuario y Clave los consigues en tu proveedor de correo (ej. Mailtrap, Gmail, Brevo, AWS SES).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# CONFIGURACIÓN DE AMAZON WEB SERVICES (S3)
# ==============================================================================
# Estos datos los proporciona AWS en tu Consola de IAM y S3 si decides guardar tus archivos en la nube de Amazon.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# CONFIGURACIÓN PARA EL FRONTEND (Vite / React / Vue)
# ==============================================================================
# Las variables que empiecen con VITE_ estarán disponibles públicamente en tu código JavaScript/Frontend.
VITE_APP_NAME="${APP_NAME}"
